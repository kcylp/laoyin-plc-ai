              <Culture>zh-CN</Culture>
              <Text>ladder start stop</Text>
            </AttributeList>
          </MultilingualTextItem>
        </ObjectList>
      </MultilingualText>
      <SW.Blocks.CompileUnit ID="3" CompositionName="CompileUnits">
        <AttributeList>
          <NetworkSource>
            <FlgNet xmlns="http://www.siemens.com/automation/Openness/SW/NetworkSource/FlgNet/v4">
              <Parts>
                <Access UId="31" Scope="LocalVariable">
                  <Symbol>
                    <Component Name="Start" />
                  </Symbol>
                </Access>
                <Access UId="32" Scope="LocalVariable">
                  <Symbol>
                    <Component Name="Stop" />
                  </Symbol>
                </Access>
                <Access UId="33" Scope="LocalVariable">
                  <Symbol>
                    <Component Name="Motor" />
                  </Symbol>
                </Access>
                <Part Name="Contact" UId="21" />
                <Part Name="Contact" UId="22">
                  <Negated Name="operand" />
                </Part>
                <Part Name="Coil" UId="23" />
              </Parts>
              <Wires>
                <Wire UId="51">
                  <Powerrail />
                  <NameCon UId="21" Name="in" />
                </Wire>
                <Wire UId="52">
                  <IdentCon UId="31" />
                  <NameCon UId="21" Name="operand" />
                </Wire>
                <Wire UId="53">
                  <NameCon UId="21" Name="out" />
                  <NameCon UId="22" Name="in" />
                </Wire>
                <Wire UId="54">
                  <IdentCon UId="32" />
                  <NameCon UId="22" Name="operand" />
                </Wire>
                <Wire UId="55">
                  <NameCon UId="22" Name="out" />
                  <NameCon UId="23" Name="in" />
                </Wire>
                <Wire UId="56">
                  <IdentCon UId="33" />
                  <NameCon UId="23" Name="operand" />
                </Wire>
              </Wires>
            </FlgNet>
          </NetworkSource>
          <ProgrammingLanguage>LAD</ProgrammingLanguage>
        </AttributeList>
        <ObjectList>
          <MultilingualText ID="4" CompositionName="Comment">
            <ObjectList>
              <MultilingualTextItem ID="5" CompositionName="Items">
                <AttributeList>
                  <Culture>zh-CN</Culture>
                  <Text>network 1</Text>
                </AttributeList>
              </MultilingualTextItem>
            </ObjectList>
          </MultilingualText>
          <MultilingualText ID="6" CompositionName="Title">
            <ObjectList>
              <MultilingualTextItem ID="7" CompositionName="Items">
                <AttributeList>
                  <Culture>zh-CN</Culture>
                  <Text>start stop ladder</Text>
                </AttributeList>
              </MultilingualTextItem>
            </ObjectList>
          </MultilingualText>
        </ObjectList>
      </SW.Blocks.CompileUnit>
      <MultilingualText ID="8" CompositionName="Title">
        <ObjectList>
          <MultilingualTextItem ID="9" CompositionName="Items">
            <AttributeList>
              <Culture>zh-CN</Culture>
              <Text>LAD_StartStop</Text>
