          </Section>
          <Section Name="InOut" />
          <Section Name="Temp" />
          <Section Name="Constant" />
          <Section Name="Return">
            <Member Name="Ret_Val" Datatype="Void" Accessibility="Public" />
          </Section>
        </Sections>
      </Interface>
      <IsIECCheckEnabled>true</IsIECCheckEnabled>
