{
    S7_EditorMode := "SCL";
    S7_Optimized := "TRUE";
    S7_Version := "0.1"
}
FUNCTION_BLOCK "Stress_Counter"
    VAR_INPUT
        { S7_MLC := "MLC_3zK" }
        Pulse : Bool;
        { S7_MLC := "MLC_dC" }
        Reset : Bool;
        { S7_MLC := "MLC_3LX" }
        Preset : Int;
    END_VAR
    VAR_OUTPUT
        { S7_MLC := "MLC_3qR" }
        Done : Bool;
        { S7_MLC := "MLC_3bd" }
        CurrentValue : Int;
    END_VAR
    VAR
        { S7_MLC := "MLC_4jN" }
        Cnt : CTU_INT;
    END_VAR

    { S7_Language := "SCL" }
    NETWORK
        
            // 实测规则：计数器的 Q 必须在调用时用 => 绑定，事后 #Cnt.Q 报"未定义"；CV 可事后读
            #Cnt(CU := #Pulse, R := #Reset, PV := #Preset, Q => #Done);
            #CurrentValue := #Cnt.CV;
        
    END_NETWORK
END_FUNCTION_BLOCK
