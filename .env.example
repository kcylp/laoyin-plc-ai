# ================= 服务器配置 =================
PORT=3000

# ================= 数据库 =================
# 使用内置 SQLite，无需安装 PostgreSQL
DB_PATH=./plc_assistant.db
JWT_SECRET=请改成一段随机长字符串

# ================= 管理员（老板） =================
# 管理员密钥，用于登录 admin.html
ADMIN_KEY=请改成你自己的密钥
# 管理员邮箱，接收用户注册审批通知
ADMIN_EMAIL=25855835@qq.com

# ================= AI 模型配置 =================
# 模型一：DeepSeek
DEEPSEEK_API_KEY=你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型二：my_gateway / K3
K3_API_KEY=你的网关密钥
K3_BASE_URL=https://tokenhub.scjwb.com/v1

# ================= 邮箱 SMTP 配置 =================
# 用你 25855835@qq.com 的 SMTP 授权码（QQ邮箱-设置-账号-开启SMTP获取授权码）
# 授权码与登录密码不同：QQ邮箱 → 设置 → 账户 → POP3/IMAP/SMTP 服务 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=25855835@qq.com
SMTP_PASS=你的QQ邮箱SMTP授权码

# ================= 邮件审批 IMAP 配置 =================
# 收邮件用（老板直接回复审批邮件），与 SMTP 共用同一个 QQ 授权码。
# 未配置时自动回退为“点链接审批”（/api/approve），平台功能不受影响。
IMAP_HOST=imap.qq.com
IMAP_PORT=993
# IMAP_USER / IMAP_PASS 默认复用 SMTP_USER / SMTP_PASS，无需单独配置
# IMAP_USER=25855835@qq.com
# IMAP_PASS=你的QQ邮箱IMAP授权码
# 仅本地调试时设为 true 可跳过 TLS 证书校验（默认校验，不要在生产打开）
# IMAP_ALLOW_INSECURE_TLS=false

# 站点地址（审批邮件里的链接前缀，本地开发用 http://localhost:3000）
SITE_URL=http://localhost:3000
